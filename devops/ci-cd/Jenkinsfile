pipeline {
    agent any

    environment {
        SERVICES = 'config-server discovery-server customers-service vets-service visits-service api-gateway'
        // TAG is not fixed anymore. We set it per build to the git commit SHA
        // (see the "Set tag" stage), so every build makes a unique image.
    }

    stages {

        // Get the code from GitHub.
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/Mohanadsherby/spring-petclinic-microservices.git'
            }
        }

        // Use the short git commit SHA as the image tag (unique per commit).
        stage('Set tag') {
            steps {
                script {
                    env.TAG = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
                    echo "Image tag for this build: ${env.TAG}"
                }
            }
        }

        // Build all the service jars.
        stage('Build jars') {
            steps {
                sh './mvnw clean package -DskipTests'
            }
        }

        // Build an image per service, scan it, then push it to Nexus.
        stage('Build & push images') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'nexus-credentials', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh '''
                        docker login localhost:8084 -u $USER -p $PASS

                        for svc in $SERVICES; do
                            docker build --provenance=false -f devops/docker/$svc/Dockerfile -t localhost:8084/docker-hosted/dev/$svc:$TAG spring-petclinic-$svc

                            # Security scan (Phase 4). Runs Trivy as a throwaway container.
                            docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy-cache:/root/.cache/trivy aquasec/trivy:latest image --scanners vuln --severity HIGH,CRITICAL --timeout 15m --exit-code 0 localhost:8084/docker-hosted/dev/$svc:$TAG || true

                            docker push localhost:8084/docker-hosted/dev/$svc:$TAG
                        done
                    '''
                }
            }
        }

        // GitOps write-back: put the new tag into the values files and push to git.
        // ArgoCD sees the git change and deploys the new images.
        stage('Update manifests (GitOps)') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GH_USER', passwordVariable: 'GH_TOKEN')]) {
                    sh '''
                        # Write the new tag into every service values file.
                        for svc in $SERVICES; do
                            sed -i "s|^tag:.*|tag: $TAG|" devops/helm/petclinic/values/$svc.yaml
                        done

                        git config user.email "jenkins@petclinic.local"
                        git config user.name "jenkins"
                        git add devops/helm/petclinic/values/
                        git commit -m "ci: deploy images tagged $TAG" || echo "nothing to commit"
                        git push https://$GH_USER:$GH_TOKEN@github.com/Mohanadsherby/spring-petclinic-microservices.git HEAD:main
                    '''
                }
            }
        }

        // NOTE: still no Deploy stage. ArgoCD (GitOps) deploys from git once the
        // stage above pushes the new tag. Jenkins only builds, scans, pushes and
        // updates the manifests.
    }
}
